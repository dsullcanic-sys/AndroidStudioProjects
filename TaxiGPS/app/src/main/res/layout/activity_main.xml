<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CODE: 349"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="10dp"/>

        <TextView
            android:id="@+id/tvDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#33691E"
            android:gravity="center"
            android:padding="8dp"
            android:text="Dirección actual..." />

        <Button
            android:id="@+id/btnActualizar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizar ubicación"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_gravity="center_horizontal"
            android:padding="8dp"
            android:backgroundTint="#1E88E5"
            android:textColor="#fff"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvLabelCercanos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Taxis más cercanos"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="15dp"
            android:paddingBottom="7dp"
            android:textColor="#01579B"/>

        <TableLayout
            android:id="@+id/tableCercanos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"/>

        <TextView
            android:id="@+id/tvLabelResto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Otros taxis"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingTop="15dp"
            android:textColor="#37474F"/>

        <TableLayout
            android:id="@+id/tableResto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"/>
    </LinearLayout>
</ScrollView>
