<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloClientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clientes"
        android:textSize="22sp"
        android:gravity="center"
        android:layout_marginBottom="10dp"/>

    <!-- Campo de búsqueda -->
    <EditText
        android:id="@+id/edtCiBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Carnet o nombre"
        android:layout_marginBottom="8dp"/>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnBuscarCliente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Buscar"/>

        <Button
            android:id="@+id/btnLimpiarCliente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Limpiar"/>
    </LinearLayout>

    <!-- Mensaje resultado/error -->
    <TextView
        android:id="@+id/tvResultadoCliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- SCROLL vertical + horizontal para la tabla -->
    <ScrollView
        android:id="@+id/scrollClientesVertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <HorizontalScrollView
            android:id="@+id/scrollClientesHorizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TableLayout
                android:id="@+id/tableClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*"/>
        </HorizontalScrollView>
    </ScrollView>

    <!-- Gráfico debajo de la tabla -->
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/barChartClientes"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone"/>
</LinearLayout>
