<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Barra de búsqueda y botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/edtBuscarDepartamento"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:hint="ID o nombre del departamento"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btnBuscarDepartamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar"
                android:layout_marginLeft="8dp"/>

            <Button
                android:id="@+id/btnLimpiarDepartamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpiar"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvResultadoDepartamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:layout_marginBottom="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:textSize="16sp"/>

        <!-- Scroll horizontal para tabla -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <TableLayout
                android:id="@+id/tableDepartamentos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>

        <!-- Gráfico siempre abajo de la tabla -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieChartDepartamento"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>
</ScrollView>
