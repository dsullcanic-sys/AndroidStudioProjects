<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Barra de búsqueda y botones -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/edtCiBuscar"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:hint="Carnet o Nombre del cliente"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btnBuscarCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar"
                android:layout_marginLeft="8dp"/>

            <Button
                android:id="@+id/btnLimpiarCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpiar"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvResultadoCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:text=""
            android:textSize="16sp"
            android:layout_marginBottom="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"/>

        <!-- Paginación -->
        <LinearLayout
            android:id="@+id/layoutPaginacionCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnAnteriorCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anterior" />

            <Button
                android:id="@+id/btnSiguienteCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Siguiente"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPaginacionCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="" />

        <!-- Scroll horizontal para la tabla -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <TableLayout
                android:id="@+id/tableClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>

        <!-- Gráfico de barras del resumen, siempre abajo -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChartClientes"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>
</ScrollView>
